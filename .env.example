# iLovePDF API Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# Required: Your iLovePDF API credentials
# Get these from https://developer.ilovepdf.com
ILOVEPDF_PUBLIC_KEY=your_public_key_here
ILOVEPDF_SECRET_KEY=your_secret_key_here

# Optional: Python logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
PYTHONLOGLEVEL=INFO

# Optional: API server configuration (usually not needed)
# START_SERVER_URL=https://api.ilovepdf.com
# API_HOST=api.ilovepdf.com
# DEFAULT_TIMEOUT_SECONDS=10

# For SignTask integration tests, you must define the following parameters:
# SIGNER_NAME = "John Doe"
# SIGNER_EMAIL = "john.doe@example.com"
